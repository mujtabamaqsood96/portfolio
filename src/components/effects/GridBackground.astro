---
/**
 * Decorative animated background:
 *  - Subtle dotted grid (CSS-only, fixed)
 *  - Two large slow-floating gradient orbs
 *  - Optional faint vertical scan line
 *
 * Pure CSS, no JS, no client-side cost. Pointer-events: none.
 */
type Props = {
  /** Whether to render the slow scan line. Defaults to true on hero. */
  scanLine?: boolean;
};
const { scanLine = false } = Astro.props as Props;
---

<div class="grid-bg" aria-hidden="true">
  <div class="grid-bg__dots"></div>
  <div class="grid-bg__orb grid-bg__orb--cyan"></div>
  <div class="grid-bg__orb grid-bg__orb--violet"></div>
  {scanLine && <div class="grid-bg__scan"></div>}
</div>

<style>
  .grid-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .grid-bg__dots {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(229, 231, 235, 0.06) 1px, transparent 1px),
      linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
    background-size:
      24px 24px,
      96px 96px,
      96px 96px;
    background-position:
      0 0,
      0 0,
      0 0;
    mask-image: radial-gradient(ellipse at center, black 35%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 80%);
  }

  .grid-bg__orb {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 9999px;
    filter: blur(120px);
    opacity: 0.55;
    will-change: transform;
  }

  .grid-bg__orb--cyan {
    top: -120px;
    left: -160px;
    background: radial-gradient(circle at center, rgba(34, 211, 238, 0.6), transparent 65%);
    animation: float-orb 18s ease-in-out infinite;
  }

  .grid-bg__orb--violet {
    bottom: -180px;
    right: -180px;
    background: radial-gradient(circle at center, rgba(167, 139, 250, 0.5), transparent 65%);
    animation: float-orb 22s ease-in-out infinite reverse;
  }

  .grid-bg__scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 220px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(34, 211, 238, 0.06) 50%,
      transparent 100%
    );
    animation: scan-line 9s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-bg__orb,
    .grid-bg__scan {
      animation: none;
    }
  }
</style>
