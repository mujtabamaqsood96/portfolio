---
import { Icon } from "astro-icon/components";
import { profile } from "@data/profile.ts";

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="container-page foot__inner">
    <div class="foot__brand">
      <span class="foot__monogram" aria-hidden="true">{profile.monogram}</span>
      <div>
        <p class="foot__name">{profile.name}</p>
        <p class="foot__role">Computer Engineer</p>
      </div>
    </div>

    <ul class="foot__socials" aria-label="Social links">
      <li>
        <a
          href={profile.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <Icon name="simple-icons:github" />
        </a>
      </li>
      <li>
        <a
          href={profile.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <Icon name="simple-icons:linkedin" />
        </a>
      </li>
      <li>
        <a href={profile.socials.email} aria-label="Email">
          <Icon name="tabler:mail" />
        </a>
      </li>
    </ul>

    <div class="foot__meta">
      <p>
        © {year} {profile.name}. All rights reserved.
      </p>
      <p class="foot__credit">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        · Hosted on
        <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">
          GitHub Pages
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
    background-color: rgba(10, 10, 15, 0.6);
  }

  .foot__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .foot__inner {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .foot__brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .foot__monogram {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    color: #06121a;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .foot__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-fg);
  }

  .foot__role {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--color-fg-subtle);
  }

  .foot__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }

  .foot__socials a {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    transition: all 180ms ease;
  }

  .foot__socials a:hover {
    color: var(--color-accent);
    border-color: rgba(34, 211, 238, 0.5);
    background-color: var(--color-surface);
  }

  .foot__socials :global(svg) {
    width: 16px;
    height: 16px;
  }

  .foot__meta {
    text-align: left;
    font-size: 0.8rem;
    color: var(--color-fg-subtle);
  }

  @media (min-width: 768px) {
    .foot__meta {
      text-align: right;
    }
  }

  .foot__meta p {
    margin: 0;
    line-height: 1.6;
  }

  .foot__credit a {
    color: var(--color-fg-muted);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-border-strong);
    transition: color 180ms ease, border-color 180ms ease;
  }

  .foot__credit a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
