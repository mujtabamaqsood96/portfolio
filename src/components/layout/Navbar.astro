---
import { Icon } from "astro-icon/components";
import { profile } from "@data/profile.ts";

const links = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Recommendations", href: "#recommendations" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Education", href: "#education" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav" id="site-nav">
  <div class="container-page nav__inner">
    <a href="#top" class="nav__brand" aria-label={`${profile.name} — home`}>
      <span class="nav__monogram" aria-hidden="true">{profile.monogram}</span>
      <span class="nav__name">{profile.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class="nav__link">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__cta">
      <a
        href={profile.socials.github}
        class="nav__icon-btn"
        aria-label="GitHub profile"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="simple-icons:github" />
      </a>
      <a
        href={profile.socials.linkedin}
        class="nav__icon-btn"
        aria-label="LinkedIn profile"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="simple-icons:linkedin" />
      </a>
      <a href="#contact" class="btn btn-primary nav__resume">
        <Icon name="tabler:mail" />
        Contact
      </a>
    </div>

    <button
      class="nav__menu-btn"
      id="nav-menu-toggle"
      aria-controls="nav-mobile"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <Icon name="tabler:menu-2" class="nav__menu-icon nav__menu-icon--open" />
      <Icon name="tabler:x" class="nav__menu-icon nav__menu-icon--close" />
    </button>
  </div>

  <nav class="nav__mobile" id="nav-mobile" aria-label="Mobile">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="nav__mobile-link" data-nav-close>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#contact" class="btn btn-primary nav__mobile-resume" data-nav-close>
          <Icon name="tabler:mail" />
          Contact
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: rgba(10, 10, 15, 0.6);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 220ms ease, background-color 220ms ease;
  }

  .nav.is-scrolled {
    background-color: rgba(10, 10, 15, 0.85);
    border-bottom-color: var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: 64px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-fg);
    text-decoration: none;
    font-weight: 600;
  }

  .nav__monogram {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    color: #06121a;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: 0 6px 18px -8px rgba(34, 211, 238, 0.7);
  }

  .nav__name {
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 1024px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__link {
    position: relative;
    padding: 0.4rem 0.75rem;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: 6px;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms ease;
  }

  .nav__link:hover,
  .nav__link.active {
    color: var(--color-fg);
  }

  .nav__link:hover::after,
  .nav__link.active::after {
    transform: scaleX(1);
  }

  .nav__cta {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 1024px) {
    .nav__cta {
      display: inline-flex;
    }
  }

  .nav__icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    transition: all 180ms ease;
  }

  .nav__icon-btn:hover {
    color: var(--color-accent);
    border-color: rgba(34, 211, 238, 0.5);
    background-color: var(--color-surface);
  }

  .nav__icon-btn :global(svg) {
    width: 16px;
    height: 16px;
  }

  .nav__resume :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* Mobile menu */
  .nav__menu-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-fg);
    cursor: pointer;
    position: relative;
  }

  @media (min-width: 1024px) {
    .nav__menu-btn {
      display: none;
    }
  }

  .nav__menu-icon {
    width: 18px;
    height: 18px;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .nav__menu-icon--close {
    position: absolute;
    opacity: 0;
    transform: rotate(-45deg);
  }

  .nav__menu-btn[aria-expanded="true"] .nav__menu-icon--open {
    opacity: 0;
    transform: rotate(45deg);
  }

  .nav__menu-btn[aria-expanded="true"] .nav__menu-icon--close {
    opacity: 1;
    transform: rotate(0);
  }

  .nav__mobile {
    display: none;
    border-top: 1px solid var(--color-border);
    background-color: rgba(10, 10, 15, 0.95);
    backdrop-filter: blur(14px);
  }

  .nav__mobile.is-open {
    display: block;
  }

  .nav__mobile ul {
    list-style: none;
    margin: 0;
    padding: 1rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav__mobile-link {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    color: var(--color-fg);
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
  }

  .nav__mobile-link:hover {
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .nav__mobile-resume {
    margin-top: 0.75rem;
    width: 100%;
  }

  .nav__mobile-resume :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-menu-toggle");
  const mobile = document.getElementById("nav-mobile");
  const main = document.getElementById("main");
  const footer = document.querySelector("footer");

  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 8) nav.classList.add("is-scrolled");
      else nav.classList.remove("is-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle && mobile) {
    let lastFocused: HTMLElement | null = null;
    const getFocusable = () =>
      Array.from(
        mobile.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute("disabled") && !el.getAttribute("aria-hidden"));

    const setMenuOpen = (open: boolean) => {
      mobile.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
      if (main) (main as HTMLElement & { inert?: boolean }).inert = open;
      if (footer) (footer as HTMLElement & { inert?: boolean }).inert = open;

      if (open) {
        lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        const [first] = getFocusable();
        first?.focus();
      } else if (lastFocused && document.contains(lastFocused)) {
        toggle.focus();
      }
    };

    toggle.addEventListener("click", () => {
      const open = !mobile.classList.contains("is-open");
      setMenuOpen(open);
    });

    mobile.querySelectorAll<HTMLElement>("[data-nav-close]").forEach((el) => {
      el.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (!mobile.classList.contains("is-open")) return;
      if (event.key === "Escape") {
        setMenuOpen(false);
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      } else if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!mobile.classList.contains("is-open")) return;
      if (mobile.contains(target) || toggle.contains(target)) return;
      setMenuOpen(false);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) setMenuOpen(false);
    });
  }

  // Active section highlight in desktop nav
  const sectionIds = [
    "about",
    "experience",
    "recommendations",
    "projects",
    "skills",
    "education",
    "contact",
  ];
  const linkBySection = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>(".nav__link").forEach((a) => {
    const id = a.getAttribute("href")?.replace("#", "") ?? "";
    if (id) linkBySection.set(id, a);
  });

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length === 0) return;
        const top = visible[0];
        const link = linkBySection.get(top.target.id);
        if (!link) return;
        linkBySection.forEach((l) => l.classList.remove("active"));
        link.classList.add("active");
      },
      { rootMargin: "-35% 0px -45% 0px", threshold: [0.05, 0.2, 0.5] },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
