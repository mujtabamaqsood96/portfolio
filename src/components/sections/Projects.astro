---
import { Icon } from "astro-icon/components";
import SectionHeading from "@components/ui/SectionHeading.astro";
import { withBase } from "@/lib/withBase.ts";
import { projects } from "@data/projects.ts";
import ProjectExternalLink from "@components/ui/ProjectExternalLink.astro";

const projectsByDate = [...projects].sort((a, b) => {
  const yearA = Number.parseInt(a.year, 10);
  const yearB = Number.parseInt(b.year, 10);
  if (Number.isFinite(yearA) && Number.isFinite(yearB) && yearA !== yearB) {
    return yearB - yearA;
  }
  if (a.status === "In Progress" && b.status !== "In Progress") return -1;
  if (b.status === "In Progress" && a.status !== "In Progress") return 1;
  return a.title.localeCompare(b.title);
});

const hardwareKeywords = ["fpga", "verilog", "vhdl", "rtl", "arm", "risc-v", "esp32", "nexus", "embedded"];
const softwareKeywords = ["python", "ai", "vision", "yolo", "tensorflow", "java", "c++", "robotics"];
const cloudKeywords = ["aws", "cloud", "network", "docker", "ci/cd", "github", "tableau", "grafana", "twinemaker"];

function techTone(tech: string): "hardware" | "software" | "cloud" {
  const t = tech.toLowerCase();
  if (hardwareKeywords.some((kw) => t.includes(kw))) return "hardware";
  if (cloudKeywords.some((kw) => t.includes(kw))) return "cloud";
  if (softwareKeywords.some((kw) => t.includes(kw))) return "software";
  return "software";
}
---

<section id="projects" class="section-pad" data-reveal>
  <div class="container-page">
    <SectionHeading
      label="projects"
      title="Things I've built (and things I'm building)."
      subtitle="A mix of FPGA, embedded, edge AI, robotics, and cloud work focused on practical outcomes."
    />

    {
      projectsByDate.length > 0 ? (
        <div class="projects__grid">
          {
            projectsByDate.map((p, i) => (
              <article
                class:list={["project card-glow", p.featured && "project--featured"]}
                data-reveal
                style={`transition-delay:${(i % 3) * 80}ms`}
              >
                <header class="project__head">
                  <span class="project__icon">
                    <Icon name={p.icon} />
                  </span>
                  <div class="project__head-text">
                    <h3 class="project__title">{p.title}</h3>
                    <p class="project__meta">
                      <span class="project__year">{p.year}</span>
                      {p.status && (
                        <span class:list={["project__status", `project__status--${p.status.toLowerCase().replace(/\s+/g, "-")}`]}>
                          {p.status}
                        </span>
                      )}
                    </p>
                  </div>
                  {p.featured && <span class="project__featured-tag">Featured</span>}
                </header>

                {p.image && (
                  <figure class="project__media">
                    <button
                      type="button"
                      class="project__image-btn"
                      data-project-image
                      data-project-image-src={withBase(p.image.src)}
                      data-project-image-alt={p.image.alt}
                      aria-label={`Open larger preview for ${p.title}`}
                    >
                      <img
                        src={withBase(p.image.src)}
                        alt={p.image.alt}
                        class="project__image"
                        width={p.image.width ?? 1200}
                        height={p.image.height ?? 750}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </figure>
                )}

                {p.highlights && p.highlights.filter(Boolean).length > 0 && (
                  <ul class="project__highlights" aria-label={`${p.title} highlights`}>
                    {p.highlights
                      .filter((line): line is string => Boolean(line && line.trim()))
                      .map((line) => (
                        <li>{line}</li>
                      ))}
                  </ul>
                )}

                <p class="project__summary">{p.summary}</p>

                <ul class="project__tech" aria-label="Technologies used">
                  {p.tech.map((t) => (
                    <li class="chip" data-tone={techTone(t)}>{t}</li>
                  ))}
                </ul>

                {(() => {
                  const validLinks = (p.links ?? []).filter((l) => l.href && l.href.trim() !== "#");
                  if (validLinks.length === 0) return null;
                  return (
                    <footer class="project__links">
                      {validLinks.map((l) => (
                        <ProjectExternalLink
                          href={l.href}
                          label={l.label}
                        />
                      ))}
                    </footer>
                  );
                })()}
              </article>
            ))
          }
        </div>
      ) : (
        <p class="section-empty card-glow" data-reveal>
          Projects are being refreshed. Check back soon for updated case studies.
        </p>
      )
    }

  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .section-empty {
    margin: 0;
    padding: 1.1rem 1.2rem;
    color: var(--color-fg-muted);
    font-size: 0.95rem;
  }

  @media (min-width: 640px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .project::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 85% -10%, rgba(34, 211, 238, 0.15), transparent 42%);
    opacity: 0;
    transition: opacity 240ms ease;
    pointer-events: none;
  }

  .project:hover::after {
    opacity: 1;
  }

  .project:hover,
  .project:focus-within {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.2),
      0 20px 44px -16px rgba(34, 211, 238, 0.3);
  }

  .project--featured {
    border-color: rgba(34, 211, 238, 0.35);
  }

  .project--featured::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(34, 211, 238, 0.45),
      rgba(167, 139, 250, 0.35),
      transparent 60%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .project__head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .project__featured-tag {
    margin-left: auto;
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(34, 211, 238, 0.4);
    background: rgba(34, 211, 238, 0.08);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project__icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.15), rgba(167, 139, 250, 0.15));
    color: var(--color-accent);
    border: 1px solid rgba(34, 211, 238, 0.25);
    flex-shrink: 0;
  }

  .project__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .project__head-text {
    min-width: 0;
    flex: 1;
  }

  .project__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-fg);
    line-height: 1.35;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.4rem 0 0;
  }

  .project__year {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
  }

  .project__status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
  }

  .project__status--shipped {
    border-color: rgba(34, 197, 94, 0.4);
    color: #4ade80;
    background-color: rgba(34, 197, 94, 0.08);
  }

  .project__status--in-progress {
    border-color: rgba(234, 179, 8, 0.4);
    color: #facc15;
    background-color: rgba(234, 179, 8, 0.08);
  }

  .project__status--concept {
    border-color: rgba(167, 139, 250, 0.4);
    color: #c4b5fd;
    background-color: rgba(167, 139, 250, 0.08);
  }

  .project__status--award {
    border-color: rgba(34, 211, 238, 0.5);
    color: var(--color-accent);
    background-color: rgba(34, 211, 238, 0.1);
  }

  .project__highlights {
    margin: 0 0 0.75rem;
    padding: 0 0 0 1rem;
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    line-height: 1.5;
    flex: 0 0 auto;
  }

  .project__highlights li {
    margin: 0.2rem 0;
  }

  .project__summary {
    margin: 0 0 1rem;
    color: var(--color-fg-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    flex: 1;
  }

  .project__media {
    margin: 0 0 0.9rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.02);
  }

  .project__image-btn {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
  }

  .project__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    transition: transform 260ms ease;
  }

  .project:hover .project__image {
    transform: scale(1.03);
  }

  .project-lightbox {
    border: none;
    padding: 0;
    background: transparent;
    width: min(86vw, 880px);
    max-width: 86vw;
    margin: auto;
    overflow: visible;
  }

  .project-lightbox[open] {
    animation: lightbox-pop 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-lightbox::backdrop {
    background: rgba(5, 8, 16, 0.72);
    backdrop-filter: blur(6px) saturate(120%);
  }

  .project-lightbox__frame {
    position: relative;
    border: 1px solid rgba(34, 211, 238, 0.18);
    border-radius: 1rem;
    background: linear-gradient(180deg, #0d1019 0%, #0a0c14 100%);
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(255, 255, 255, 0.02),
      0 0 60px -20px rgba(34, 211, 238, 0.25);
    padding: 0.85rem;
  }

  .project-lightbox__img {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    background: #06080f;
    border-radius: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .project-lightbox__caption {
    margin: 0.7rem 0.25rem 0.15rem;
    color: var(--color-fg-muted);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    text-align: center;
    line-height: 1.4;
  }

  .project-lightbox__close {
    position: absolute;
    top: -0.85rem;
    right: -0.85rem;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(15, 17, 26, 0.96);
    color: #e5e7eb;
    font-size: 1.05rem;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.6);
    transition:
      transform 160ms ease,
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .project-lightbox__close:hover,
  .project-lightbox__close:focus-visible {
    color: var(--color-accent);
    border-color: rgba(34, 211, 238, 0.6);
    background: rgba(17, 17, 24, 0.98);
    transform: rotate(90deg);
  }

  @keyframes lightbox-pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-lightbox[open] {
      animation: none;
    }
    .project-lightbox__close {
      transition: none;
    }
    .project-lightbox__close:hover,
    .project-lightbox__close:focus-visible {
      transform: none;
    }
  }

  .project__tech {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

</style>

<dialog id="project-lightbox" class="project-lightbox" aria-label="Project image preview">
  <div class="project-lightbox__frame">
    <button type="button" id="project-lightbox-close" class="project-lightbox__close" aria-label="Close image preview">
      ×
    </button>
    <img id="project-lightbox-image" class="project-lightbox__img" src="" alt="" />
    <p id="project-lightbox-caption" class="project-lightbox__caption"></p>
  </div>
</dialog>

<script>
  const lightbox = document.getElementById("project-lightbox") as HTMLDialogElement | null;
  const lightboxImage = document.getElementById("project-lightbox-image") as HTMLImageElement | null;
  const lightboxCaption = document.getElementById("project-lightbox-caption") as HTMLParagraphElement | null;
  const lightboxClose = document.getElementById("project-lightbox-close") as HTMLButtonElement | null;
  const imageTriggers = document.querySelectorAll<HTMLButtonElement>("[data-project-image]");

  if (lightbox && lightboxImage && imageTriggers.length > 0) {
    const openLightbox = (src: string, alt: string) => {
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      if (lightboxCaption) lightboxCaption.textContent = alt;
      if (!lightbox.open) lightbox.showModal();
    };

    const closeLightbox = () => {
      if (lightbox.open) lightbox.close();
      lightboxImage.src = "";
      lightboxImage.alt = "";
      if (lightboxCaption) lightboxCaption.textContent = "";
    };

    imageTriggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.dataset.projectImageSrc ?? "";
        const alt = btn.dataset.projectImageAlt ?? "Project image";
        if (!src) return;
        openLightbox(src, alt);
      });
    });

    lightboxClose?.addEventListener("click", closeLightbox);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox.open) closeLightbox();
    });
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    lightbox.addEventListener("close", () => {
      lightboxImage.src = "";
      lightboxImage.alt = "";
      if (lightboxCaption) lightboxCaption.textContent = "";
    });
  }
</script>
