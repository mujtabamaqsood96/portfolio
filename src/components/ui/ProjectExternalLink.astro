---
type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
const isGithub = /github\.com/i.test(href);
const isExternal = /^https?:\/\//i.test(href);
const ariaLabel = `${label}${isExternal ? " (opens in new tab)" : ""}`;
---

<a
  href={href}
  class="project-link-pill"
  aria-label={ariaLabel}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  <span class="project-link-pill__icon" aria-hidden="true">
    {
      isGithub ? (
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.7.5 12.1c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.6-.3-5.4-1.4-5.4-6 0-1.3.4-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.9 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.3v3.4c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.35.5 12 .5Z" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17 17 7" />
          <path d="M7 7h10v10" />
        </svg>
      )
    }
  </span>
  <span>{label}</span>
</a>

<style>
  .project-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-fg-muted);
    text-decoration: none;
    font-size: 0.8rem;
    transition:
      transform 160ms ease,
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .project-link-pill:hover,
  .project-link-pill:focus-visible {
    transform: translateY(-2px);
    color: var(--color-accent);
    border-color: rgba(34, 211, 238, 0.55);
    background-color: rgba(34, 211, 238, 0.08);
  }

  .project-link-pill__icon {
    width: 14px;
    height: 14px;
    display: inline-grid;
    place-items: center;
  }

  .project-link-pill__icon svg {
    width: 100%;
    height: 100%;
  }
</style>
