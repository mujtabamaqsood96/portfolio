---
/**
 * Standardized section heading:
 *   <span class="mono-tag">// label</span>
 *   <h2>Title</h2>
 *   <p>Optional subtitle</p>
 */
type Props = {
  id?: string;
  label: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
};
const { id, label, title, subtitle, align = "left" } = Astro.props as Props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---

<header
  id={id}
  class:list={["max-w-2xl mb-10 md:mb-14", alignClass]}
  data-reveal
>
  <p class="mono-tag mb-3" aria-hidden="true">// {label}</p>
  <h2
    class="font-[family-name:var(--font-display)] text-3xl md:text-4xl lg:text-[2.7rem] font-semibold tracking-tight leading-[1.12]"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-3.5 text-fg-muted text-[0.95rem] md:text-[1.05rem] leading-[1.65] max-w-2xl">
        {subtitle}
      </p>
    )
  }
</header>
